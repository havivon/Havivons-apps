    "printmybingo": {
      "category": "web",
      "order": 9,
      "remote": {
        "kind": "release",
        "repo": "havivon/printmybingo-site",
        "asset": ".apk",
        "host": {
          "to": "web/printmybingo",
          "drop": [
            "CNAME",
            "ads.txt",
            "blog/blog"
          ],
          "rewrite": {
            "https://printmybingo.com/": "https://havivon.github.io/Havivons-apps/web/printmybingo/"
          },
          "strip_tracking": true,
          "relative_links": true
        }
      }
    },
    "pdf": {
      "category": "web",
      "order": 10,
      "path": "F:/My Projects/PDF",
      "artifact": [
        "PDF Creator/PDF-Creator-Offline.html"
      ],
      "host": {
        "from": "PDF.html",
        "to": "web/pdf/index.html"
      },
      "apk": [
        "PDF Creator/dist/PDF-Creator-*.apk"
      ]
    },
    "mahjong": {
      "category": "game",
      "order": 11,
      "path": "F:/My Projects/mahjong",
      "artifact": [
        "app/build/outputs/apk/release/*.apk",
