{
  "_comment": "Where each app's latest build lives. Used by sync.py. category: android | web | game | desktop",
  "apps": {
    "pigeon": {
      "category": "android",
      "order": 1,
      "path": "F:/My Projects/Pigeon",
      "artifact": [
        "dist/*.apk",
        "app/build/outputs/apk/release/*.apk",
        "app/build/outputs/apk/debug/*.apk"
      ],
      "version_file": "app/build.gradle.kts",
      "repo": "havivon/Pigeon"
    },
    "smartfiles": {
      "category": "android",
      "order": 2,
      "path": "F:/My Projects/SmartFileManager",
      "artifact": [
        "dist/*.apk",
        "app/build/outputs/apk/release/*.apk"
      ],
      "version_file": "app/build.gradle.kts",
      "repo": "havivon/SmartFileManager"
    },
    "hebreminder": {
      "category": "android",
      "order": 3,
      "path": "F:/My Projects/HebReminder-v5",
      "store": "https://play.google.com/store/apps/details?id=com.hebreminder.app",
      "artifact": [
        "app/build/outputs/apk/release/*.apk"
      ],
      "version_file": "app/build.gradle.kts"
    },
    "zochrim": {
      "category": "android",
      "order": 4,
      "path": "F:/My Projects/Memory/ZochrimApp",
      "artifact": [
        "app/build/outputs/apk/release/*.apk",
        "app/build/outputs/apk/debug/*.apk"
      ],
      "version_file": "app/build.gradle"
    },
    "newplayer": {
      "category": "android",
      "order": 5,
      "remote": {
        "kind": "release",
        "repo": "havivon/NewPlayer",
        "asset": ".apk"
      }
    },
    "babymonitor": {
      "category": "android",
      "order": 6,
      "remote": {
        "kind": "release",
        "repo": "havivon/BabyMonitor",
        "asset": ".apk"
      }
    },
    "ragua": {
      "category": "web",
      "order": 7,
      "open": "https://havivon.github.io/child-behavior/",
      "remote": {
        "kind": "file",
        "repo": "havivon/child-behavior",
        "file": "dist/ragua-vehazak.apk"
      }
    },
    "wa-unsaved": {
      "category": "web",
      "order": 8,
      "open": "https://havivon.github.io/Whatsapp-incognito/",
      "remote": {
        "kind": "commit",
        "repo": "havivon/Whatsapp-incognito"
      }
    },
    "printmybingo": {
      "category": "web",
      "order": 9,
      "remote": {
        "kind": "release",
        "repo": "havivon/printmybingo-site",
        "asset": ".apk",
        "host": {
          "to": "web/printmybingo",
          "drop": ["CNAME", "ads.txt", "blog/blog"],
          "rewrite": {"https://printmybingo.com/": "https://havivon.github.io/Havivons-apps/web/printmybingo/"},
          "strip_tracking": true,
          "relative_links": true
        }
      }
    },
    "pdf": {
      "category": "web",
      "order": 10,
      "path": "F:/My Projects/PDF",
      "artifact": [
        "PDF Creator/PDF-Creator-Offline.html"
      ],
      "host": {
        "from": "PDF.html",
        "to": "web/pdf/index.html"
      }
    },
    "mahjong": {
      "category": "game",
      "order": 11,
      "path": "F:/My Projects/mahjong",
      "artifact": [
        "app/build/outputs/apk/release/*.apk",
        "app/build/outputs/apk/debug/*.apk"
      ],
      "version_file": "app/build.gradle.kts",
      "repo": "havivon/mahjong"
    },
    "hidon": {
      "category": "game",
      "order": 12,
      "path": "F:/My Projects/Hidon",
      "artifact": [
        "dist/hidon.html"
      ],
      "host": {
        "from": "dist/hidon.html",
        "to": "web/hidon/index.html"
      }
    },
    "tamlelan": {
      "category": "web",
      "order": 14,
      "path": "F:/My Projects/Tamlelan",
      "host": {
        "to": "web/tamlelan",
        "files": [
          "index.html",
          "app.js",
          "style.css",
          "manifest.json",
          "sw.js",
          "icon.svg",
          "icon-*.png",
          "icon.ico",
          "vendor/jszip.min.js"
        ]
      }
    },
    "reply-forward": {
      "category": "desktop",
      "order": 15,
      "path": "F:/My Projects/Replay and Forward",
      "artifact": [
        "publish/*.zip",
        "publish/setup.exe",
        "*.msi"
      ]
    },
    "architext": {
      "category": "web",
      "order": 16,
      "path": "F:/My Projects/Architext",
      "artifact": [
        "Architext_Pro.html"
      ],
      "host": {
        "from": "Architext_Pro.html",
        "to": "web/architext/index.html"
      }
    }
  }
}
