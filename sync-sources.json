    "newplayer": {
      "category": "android",
      "order": 5,
      "remote": {
        "kind": "release",
        "repo": "havivon/NewPlayer",
        "asset": ".apk"
      }
    },
    "babymonitor": {
      "category": "android",
      "order": 6,
      "remote": {
        "kind": "release",
        "repo": "havivon/BabyMonitor",
        "asset": ".apk"
      }
    },
    "ragua": {
      "category": "web",
      "order": 7,
      "open": "https://havivon.github.io/child-behavior/",
      "remote": {
        "kind": "file",
        "repo": "havivon/child-behavior",
        "file": "dist/ragua-vehazak.apk"
      }
    },
    "wa-unsaved": {
      "category": "web",
      "order": 8,
